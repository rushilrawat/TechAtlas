{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://techatlas.dev/schema/graph-schema.json",
  "title": "TechAtlas Graph Dataset",
  "description": "Canonical schema for the TechAtlas knowledge graph. One canonical node per entity; typed, meaningful edges.",
  "type": "object",
  "required": ["version", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "Dataset version, e.g. '0.1.0'. Layout snapshots and popularity scores are keyed to this.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/definitions/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/definitions/edge" }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "name", "node_type", "primary_domain", "short_description"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Canonical ID, e.g. 'technology:python'. Exactly one per entity.",
          "pattern": "^(domain|concept|technology):[a-z0-9][a-z0-9-]*$"
        },
        "slug": {
          "type": "string",
          "description": "URL slug, unique within node_type. e.g. 'python'.",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "node_type": {
          "type": "string",
          "enum": ["domain", "concept", "technology"]
        },
        "node_subtype": {
          "type": ["string", "null"],
          "enum": [
            null,
            "programming_language", "framework", "library", "database",
            "runtime", "platform", "cloud_service", "developer_tool",
            "protocol", "standard", "architecture", "technique", "methodology",
            "operating_system", "engine", "sdk"
          ]
        },
        "short_description": { "type": "string", "minLength": 1, "maxLength": 280 },
        "long_description": { "type": ["string", "null"] },
        "primary_domain": {
          "type": "string",
          "description": "ID of the domain node this entity primarily belongs to. Must reference an existing domain node. Domains reference themselves.",
          "pattern": "^domain:[a-z0-9-]+$"
        },
        "official_url": { "type": ["string", "null"], "format": "uri" },
        "documentation_url": { "type": ["string", "null"], "format": "uri" },
        "wikipedia_title": {
          "type": ["string", "null"],
          "description": "Exact Wikipedia article title (NOT auto-derived from name). e.g. 'Python (programming language)'."
        },
        "wikidata_id": {
          "type": ["string", "null"],
          "pattern": "^Q[0-9]+$"
        },
        "lifecycle_status": {
          "type": "string",
          "enum": ["active", "emerging", "mature", "deprecated", "historical"],
          "default": "active"
        },
        "aliases": {
          "type": "array",
          "description": "Alternative names, abbreviations, and synonyms used for search.",
          "items": { "type": "string" },
          "default": []
        },
        "importance": {
          "type": ["number", "null"],
          "description": "Editorial structural importance 0..1. Used for sizing domains/concepts (NOT the technology popularity scale).",
          "minimum": 0,
          "maximum": 1
        },
        "repo": {
          "type": ["string", "null"],
          "description": "Source repository as 'owner/name' (currently GitHub), used by the Phase 1D popularity pipeline to fetch stars/activity. Optional.",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "package": {
          "type": ["object", "null"],
          "description": "Package-registry identity used by the popularity pipeline to fetch download counts. Optional.",
          "additionalProperties": false,
          "required": ["ecosystem", "name"],
          "properties": {
            "ecosystem": {
              "type": "string",
              "enum": ["npm", "pypi", "crates", "maven", "nuget", "rubygems", "packagist", "go"]
            },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        "auto_added": {
          "type": ["boolean", "null"],
          "description": "True when the node was added by the scheduled discovery auto-ingest (identity + primary domain are source-derived; richer typed edges are NOT auto-generated and may be added by a curator later). Absent/false for hand-curated nodes."
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "relationship_type"],
      "properties": {
        "source": { "type": "string", "description": "Source node id." },
        "target": { "type": "string", "description": "Target node id." },
        "relationship_type": {
          "type": "string",
          "enum": [
            "belongs_to_domain", "has_subdomain", "related_to", "implements",
            "used_for", "written_in", "built_on", "depends_on", "integrates_with",
            "alternative_to", "commonly_used_with", "supports", "part_of_ecosystem",
            "enables"
          ]
        },
        "weight": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "description": { "type": ["string", "null"] },
        "source_reference": {
          "type": ["string", "null"],
          "description": "Provenance for significant relationships."
        },
        "is_curated": {
          "type": "boolean",
          "description": "true = hand-verified editorial relationship; false = inferred, must be validated before trusting.",
          "default": true
        }
      }
    }
  }
}
