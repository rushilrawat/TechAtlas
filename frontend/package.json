{
  "name": "techatlas-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:xray": "playwright test -c playwright.xray.config.ts",
    "e2e:stackview": "playwright test -c playwright.stackview.config.ts",
    "build:xray-test": "VITE_BASE=/TechAtlas/ VITE_STATIC_API=true VITE_SCANNER_API=/api/v1 VITE_TEST_HOOKS=true vite build && rm -rf dist-xray-test && mv dist dist-xray-test"
  },
  "dependencies": {
    "@sigma/node-border": "^3.0.0",
    "graphology": "^0.26.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sigma": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "1.48.2",
    "@testing-library/react": "^16.0.1",
    "@types/node": "20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.2",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
